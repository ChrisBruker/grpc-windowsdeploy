# Conan profile for Windows MSVC builds
# Save this as profiles/msvc_profile in your Conan cache or use with -pr flag

[settings]
os=Windows
arch=x86_64
compiler=msvc
# Visual Studio 2026 (adjust based on your VS version)
compiler.version=195
# C++17 standard required for gRPC
compiler.cppstd=17
compiler.runtime=dynamic
build_type=Release


[conf]
# Enable parallel builds
tools.cmake.cmaketoolchain:generator=Visual Studio 18 2026
tools.build:jobs=4

[tool_requires]
cmake/4.2.3